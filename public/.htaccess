# Hostinger LiteSpeed / Apache Configuration for Adapt India Network

DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 0a. One address for the whole site: https://www.adapt-india.net
  #     (http:// and non-www versions 301-redirect here, so Google sees one site, not two)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^adapt-india\.net$ [NC]
  RewriteRule ^(.*)$ https://www.adapt-india.net/$1 [R=301,L]

  # 0b. Old / duplicate URLs -> main page (301 keeps any ranking they have)
  RewriteRule ^faq/?$ /faqs/ [R=301,L]
  RewriteRule ^privacy/?$ /privacy-policy/ [R=301,L]
  RewriteRule ^terms/?$ /terms-and-conditions/ [R=301,L]
  RewriteRule ^cookies/?$ /cookie-preferences/ [R=301,L]
  RewriteRule ^work/?$ /services/ [R=301,L]
  RewriteRule ^industries(/.*)?$ /services/ [R=301,L]
  RewriteRule ^blog/network-architecture/?$ /blog/ [R=301,L]
  RewriteRule ^services/internet-leased-line/?$ /services/smart-internet-ill/ [R=301,L]
  RewriteRule ^services/sd-wan/?$ /services/smartflo-sd-wan/ [R=301,L]
  RewriteRule ^services/mpls/?$ /services/managed-mpls/ [R=301,L]
  RewriteRule ^services/managed-wifi/?$ /services/managed-campus-wifi/ [R=301,L]
  RewriteRule ^services/cloud-telephony/?$ /services/business-communications/ [R=301,L]
  RewriteRule ^services/cyber-security/?$ /services/cybersecurity-solutions/ [R=301,L]
  RewriteRule ^services/data-services/?$ /services/point-to-point-leased-line/ [R=301,L]

  # 0c. Pages left over from the old web-agency template (not telecom services) -> Services
  RewriteRule ^services/(seo-services|google-ads|meta-ads|web-development|app-development|ui-ux-design|ai-automation|whatsapp-marketing|social-media|content-marketing|email-marketing|local-seo-gmb|cloud-devops|it-consulting|enterprise-software)/?$ /services/ [R=301,L]

  # 0d. Spam URLs injected into the old PHP site -> 410 Gone, so Google drops them for good
  #     (e.g. /products/17521930, /shop/3287213.shtml, /index.php?products/832674, WordPress feeds)
  RewriteCond %{QUERY_STRING} (^|&)products [NC]
  RewriteRule ^index\.php$ - [G,L]
  RewriteRule ^(products|shop)(/.*)?$ - [G,L]
  RewriteRule ^(comments/)?feed/?$ - [G,L]

  # 0e. Real pages from the old PHP site -> matching new page (trailing ? drops old query strings)
  RewriteRule ^index\.php$ /? [R=301,L]
  RewriteRule ^fiber-leased-line-service-provider\.php$ /services/smart-internet-ill/? [R=301,L]
  RewriteRule ^enterprise-broadband\.php$ /services/enterprise-broadband/? [R=301,L]
  RewriteRule ^blog-details\.php$ /blog/? [R=301,L]
  RewriteRule ^cloud-telephony-solution-service-provider\.php$ /services/business-communications/? [R=301,L]
  RewriteCond %{QUERY_STRING} (^|&)service=sd-wan(&|$) [NC]
  RewriteRule ^service-details\.php$ /services/smartflo-sd-wan/? [R=301,L]
  RewriteCond %{QUERY_STRING} (^|&)service=mpls(&|$) [NC]
  RewriteRule ^service-details\.php$ /services/managed-mpls/? [R=301,L]
  RewriteRule ^service-details\.php$ /services/? [R=301,L]
  RewriteRule ^contact-us/?$ /contact/ [R=301,L]

  # 1. Route Contact Form API to PHP Mailer Handler
  RewriteRule ^api/contact/?$ contact.php [L,QSA]

  # 2. If the request matches an existing file or directory, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. Check for folder/index.html
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/?$ $1/index.html [L]

  # 4. Check for .html extension
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # 5. Anything else is a real 404 (handled by ErrorDocument below with a 404 status,
  #    instead of serving 404.html with a 200 status, which Google treats as a "soft 404")
</IfModule>

# Custom Error Pages
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

# Compression (faster pages = better Core Web Vitals)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# Caching for static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
